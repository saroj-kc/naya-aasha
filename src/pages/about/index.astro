---
import Base from '../../layouts/BaseLayout.astro'; import about from '../../content/pages/about.json'; import {getCollection} from 'astro:content';
const team=(await getCollection('team',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order);
---
<Base title={about.seoTitle} description={about.seoDescription}><section class="page-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / About us</p><p class="eyebrow">{about.eyebrow}</p><h1 class="display">A new hope, <em style="color:var(--green);font-weight:400">built together.</em></h1><p class="lead">{about.intro}</p></div></section><section class="section"><div class="wrap content-grid"><aside><p class="side-title">Why we exist</p></aside><div class="prose"><h2>{about.storyTitle}</h2><p>{about.story}</p><div class="mv-grid"><div class="mv-card"><span class="meta" style="color:#bcdcd3">Our mission</span><h3>What we do</h3><p>{about.mission}</p></div><div class="mv-card"><span class="meta">Our vision</span><h3>What we hope to see</h3><p>{about.vision}</p></div></div><p class="eyebrow">The principles that guide us</p><h2>Our values</h2><div class="values-grid">{about.values.map((v,i)=><article class="value-card"><span class="meta">{String(i+1).padStart(2,'0')}</span><h3>{v.title}</h3><p>{v.text}</p></article>)}</div></div></div></section>{team.length>0&&<section class="section section-tinted"><div class="wrap"><p class="eyebrow">Our people</p><h2 class="heading">Leadership & team</h2><div class="cards-3" style="margin-top:40px">{team.map(m=><article class="content-card"><div class="visual">{m.data.name[0]}</div><div class="body"><h3>{m.data.name}</h3><p>{m.data.role}</p></div></article>)}</div></div></section>}</Base>
