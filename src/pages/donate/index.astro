---
import Base from '../../layouts/BaseLayout.astro'; import site from '../../content/pages/site.json';
---
<Base title="Donate | Naya Aasha" description="Support Naya Aasha's work responsibly."><section class="page-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / Donate</p><p class="eyebrow">Give responsibly</p><h1 class="display">Your support can become <em style="color:var(--green);font-weight:400">someone’s new hope.</em></h1><p class="lead">Contributions help us respond to verified needs through transparent programs and responsible partnerships.</p></div></section><section class="section"><div class="narrow"><div class="notice"><strong>Before launch:</strong> Bank and digital-wallet information must be verified by Naya Aasha’s authorized leadership. Never publish a personal account as an organizational donation account without formal approval.</div><div class="donation-box" style="margin-top:25px"><p class="eyebrow">Donation details</p>{site.donationEnabled?<dl><dt>Bank</dt><dd>{site.bankName}</dd><dt>Account name</dt><dd>{site.accountName}</dd><dt>Account number</dt><dd>{site.accountNumber}</dd><dt>eSewa</dt><dd>{site.esewaId||'Not available'}</dd><dt>Khalti</dt><dd>{site.khaltiId||'Not available'}</dd></dl>:<p>{site.donationNotice}</p>}<a class="btn" href={`mailto:${site.email}?subject=I would like to support Naya Aasha`}>Contact us to donate</a></div><p class="note">Ask for an official receipt. Donation use and financial reporting will be published on the Transparency page.</p></div></section></Base>
