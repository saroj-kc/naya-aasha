---
import Base from '../layouts/BaseLayout.astro'; import Icon from '../components/Icon.astro'; import ProgramCard from '../components/ProgramCard.astro'; import {getCollection} from 'astro:content'; import home from '../content/pages/home.json';
const programs=(await getCollection('programs',({data})=>!data.draft&&data.featured)).sort((a,b)=>a.data.order-b.data.order);
const stories=(await getCollection('stories',({data})=>!data.draft)).sort((a,b)=>+b.data.date-+a.data.date); const story=stories.find(s=>s.data.featured)||stories[0];
---
<Base title={home.seoTitle} description={home.seoDescription}>
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow">{home.eyebrow}</p><h1 class="display">New hope begins when <em>we stand together.</em></h1><p class="lead">{home.heroText}</p><div class="actions"><a class="btn" href={home.primaryUrl}>{home.primaryLabel}<Icon name="arrow" size={18}/></a><a class="btn btn-secondary" href={home.secondaryUrl}>{home.secondaryLabel}</a></div><div class="trust-line"><span>Dignity first</span><span>Community-led</span><span>Transparent</span></div></div><div class="hero-art" aria-hidden="true"><div class="sun"></div><div class="hill"></div><div class="hope-card hope-main"><div class="nepali">आ</div><h2>Aasha means hope.</h2><p>A belief that every person deserves a fair chance to learn, heal, and thrive.</p></div><div class="hope-card float-card"><span class="float-icon"><Icon name="heart"/></span><span><strong>Care with dignity</strong><small>Not pity. Partnership.</small></span></div></div></div></section>
<section class="section"><div class="wrap about-split"><div><p class="eyebrow">{home.aboutEyebrow}</p><h2 class="heading">{home.aboutTitle}</h2></div><div><p class="lead">{home.aboutText}</p><p class="promise">We work with people—not simply for them—so that support respects choice, privacy, and local knowledge.</p><a class="text-link" href="/about/">Our mission, vision & values <Icon name="arrow" size={18}/></a></div></div></section>
<section class="section section-tinted"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Our programs</p><h2 class="heading">{home.programsTitle}</h2></div><a class="text-link" href="/programs/">View all programs <Icon name="arrow" size={18}/></a></div><div class="program-grid">{programs.map(program=><ProgramCard program={program}/>)}</div></div></section>
{story&&<section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Stories & impact</p><h2 class="heading">{home.storiesTitle}</h2></div><a class="text-link" href="/impact/">See our impact <Icon name="arrow" size={18}/></a></div><div class="story-feature"><div class="story-visual"><svg viewBox="0 0 300 300" aria-hidden="true"><circle cx="150" cy="75" r="42" fill="#f3a72e"/><path d="M60 250c14-82 55-124 90-124s76 42 90 124" fill="#167761"/><path d="M80 245c30-42 110-42 140 0" fill="none" stroke="#fff" stroke-width="10"/><path d="M112 80c9 13 23 20 38 20s29-7 38-20" fill="none" stroke="#123633" stroke-width="5"/></svg></div><div class="story-copy"><span class="meta">Featured story · {story.data.location}</span><h3>{story.data.title}</h3><p>{story.data.excerpt}</p><a class="text-link" href="/impact/">Read the story <Icon name="arrow" size={18}/></a><p class="note">Stories are published only with appropriate consent. Names and identifying details may be changed to protect privacy.</p></div></div></div></section>}
<section class="cta-band"><div class="wrap cta-inner"><div><p class="eyebrow light">Take part</p><h2 class="heading">{home.ctaTitle}</h2><p>{home.ctaText}</p></div><a class="btn btn-light" href="/get-involved/">Find your way to help <Icon name="arrow" size={18}/></a></div></section>
</Base>
