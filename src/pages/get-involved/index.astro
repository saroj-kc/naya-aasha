---
import Base from '../../layouts/BaseLayout.astro'; import page from '../../content/pages/get-involved.json';
---
<Base title={page.seoTitle} description={page.seoDescription}><section class="page-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / Get involved</p><p class="eyebrow">{page.eyebrow}</p><h1 class="display">There is more than one way <em style="color:var(--green);font-weight:400">to give hope.</em></h1><p class="lead">{page.intro}</p></div></section><section class="section"><div class="wrap option-grid">{page.options.map((o,i)=><article class="option-card"><span class="meta">{String(i+1).padStart(2,'0')}</span><h2>{o.title}</h2><p>{o.text}</p><a class="text-link" href={o.title==='Support a program'?'/donate/':'/contact/'}>{o.button} →</a></article>)}</div></section></Base>
