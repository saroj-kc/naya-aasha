---
import Base from '../../layouts/BaseLayout.astro'; import site from '../../content/pages/site.json'; import {getCollection} from 'astro:content';
const reports=(await getCollection('reports',({data})=>!data.draft)).sort((a,b)=>b.data.year-a.data.year);
---
<Base title="Transparency | Naya Aasha" description="Registration, governance, reports, and financial transparency for Naya Aasha."><section class="page-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / Transparency</p><p class="eyebrow">Accountability</p><h1 class="display">Trust is built through <em style="color:var(--green);font-weight:400">openness.</em></h1><p class="lead">This page is the permanent home for registration details, governance information, annual reports, audited statements, and program results.</p></div></section><section class="section"><div class="wrap content-grid"><aside><p class="side-title">Public information</p></aside><div><div class="notice"><strong>Registration:</strong> {site.registrationNumber}. Replace this placeholder only after documents are verified.</div><h2 class="heading" style="margin:50px 0 15px">Reports & documents</h2>{reports.length?reports.map(r=><div class="report-row"><span><strong>{r.data.title}</strong><br/><small>{r.data.type} · {r.data.year}</small></span>{r.data.file?<a class="btn btn-small" href={r.data.file}>Download</a>:<span>File pending</span>}</div>):<div class="empty-state">Verified reports will appear here once published through the CMS.</div>}<h2 class="heading" style="margin:55px 0 15px">Our commitment</h2><div class="values-grid"><div class="value-card"><h3>Clear records</h3><p>Program and financial records are maintained with appropriate supporting documents.</p></div><div class="value-card"><h3>Responsible spending</h3><p>Funds are used only for approved purposes and reviewed through defined controls.</p></div><div class="value-card"><h3>Honest reporting</h3><p>We report achievements, limitations, and lessons without exaggerating our impact.</p></div></div></div></div></section></Base>
