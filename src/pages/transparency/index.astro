---
import Base from '../../layouts/BaseLayout.astro';
import site from '../../content/pages/site.json';
import {getCollection} from 'astro:content';
const reports=(await getCollection('reports',({data})=>!data.draft)).sort((a,b)=>{
  const ad=a.data.date?.getTime()??((a.data.year??0)*31557600000);
  const bd=b.data.date?.getTime()??((b.data.year??0)*31557600000);
  return bd-ad;
});
const formatDocumentDate=(date?:Date,year?:number)=>date
  ? new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(date)
  : year&&year>=1900 ? String(year) : 'Date not specified';
---
<Base title="Transparency | Naya Aasha" description="Registration, governance, reports, and financial transparency for Naya Aasha.">
  <section class="page-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / Transparency</p><p class="eyebrow">Accountability</p><h1 class="display">Trust is built through <em style="color:var(--green);font-weight:400">openness.</em></h1><p class="lead">This page is the permanent home for registration details, governance information, annual reports, audited statements, and program results.</p></div></section>
  <section class="section"><div class="wrap content-grid"><aside><p class="side-title">Public information</p></aside><div>
    <div class="notice"><strong>Registration:</strong> {site.registrationNumber}</div>
    <h2 class="heading" style="margin:50px 0 15px">Reports & documents</h2>
    <p class="document-policy">Documents are provided for on-screen verification. Downloading, copying, and printing are not permitted without written authorization from Naya Aasha.</p>
    {reports.length?reports.map(r=><div class="report-row"><span><strong>{r.data.title}</strong><br/><small>{r.data.type} · {formatDocumentDate(r.data.date,r.data.year)}</small></span>{r.data.file?<button class="btn btn-small view-document" type="button" data-document-url={r.data.file} data-document-title={r.data.title}>View document</button>:<span>File pending</span>}</div>):<div class="empty-state">Verified reports will appear here once published through the CMS.</div>}
    <h2 class="heading" style="margin:55px 0 15px">Our commitment</h2><div class="values-grid"><div class="value-card"><h3>Clear records</h3><p>Program and financial records are maintained with appropriate supporting documents.</p></div><div class="value-card"><h3>Responsible spending</h3><p>Funds are used only for approved purposes and reviewed through defined controls.</p></div><div class="value-card"><h3>Honest reporting</h3><p>We report achievements, limitations, and lessons without exaggerating our impact.</p></div></div>
  </div></div></section>

  <dialog id="document-dialog" aria-labelledby="document-dialog-title">
    <div class="dialog-head"><div><span class="meta">Protected document viewer</span><h2 id="document-dialog-title">Document</h2></div><button type="button" class="close-document" aria-label="Close document viewer">×</button></div>
    <div class="viewer-warning">View-only copy. Downloading, copying, screenshots, photography, and printing are not authorized.</div>
    <div class="viewer-wrap"><iframe id="document-frame" title="Document viewer" loading="lazy"></iframe><div class="viewer-watermark" aria-hidden="true">NAYA AASHA · VIEW ONLY</div></div>
  </dialog>
</Base>
<script is:inline>
const dialog=document.querySelector('#document-dialog');
const frame=document.querySelector('#document-frame');
const title=document.querySelector('#document-dialog-title');
document.querySelectorAll('.view-document').forEach(button=>button.addEventListener('click',()=>{
  title.textContent=button.dataset.documentTitle||'Document';
  frame.src=`${button.dataset.documentUrl}#toolbar=0&navpanes=0&scrollbar=1&view=FitH`;
  dialog.showModal();
}));
const closeViewer=()=>{dialog.close();frame.removeAttribute('src')};
document.querySelector('.close-document')?.addEventListener('click',closeViewer);
dialog?.addEventListener('click',event=>{if(event.target===dialog)closeViewer()});
dialog?.addEventListener('contextmenu',event=>event.preventDefault());
document.addEventListener('keydown',event=>{
  if(dialog?.open&&(event.ctrlKey||event.metaKey)&&['p','s','c'].includes(event.key.toLowerCase())){
    event.preventDefault();alert('Downloading, copying, and printing this document are not authorized.');
  }
});
</script>
<style>
.document-policy{color:var(--muted);font-size:14px;margin-bottom:20px}.report-row button{font:inherit;cursor:pointer}dialog{width:min(1100px,calc(100% - 28px));height:min(90vh,900px);padding:0;border:0;border-radius:20px;background:#fff;box-shadow:0 30px 100px rgba(0,0,0,.35);overflow:hidden}dialog::backdrop{background:rgba(5,28,27,.82)}.dialog-head{min-height:82px;padding:15px 20px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line)}.dialog-head h2{font-family:var(--serif);margin:2px 0 0;font-size:24px}.close-document{width:44px;height:44px;border:0;border-radius:50%;background:var(--mint);color:var(--green-dark);font-size:30px;cursor:pointer}.viewer-warning{padding:10px 20px;background:var(--orange-soft);color:var(--ink);font-size:13px;font-weight:700}.viewer-wrap{height:calc(100% - 125px);position:relative;background:#465653}.viewer-wrap iframe{width:100%;height:100%;border:0;background:#fff}.viewer-watermark{position:absolute;pointer-events:none;z-index:2;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-28deg);font:800 clamp(24px,5vw,70px)/1 var(--sans);letter-spacing:.08em;color:rgba(12,77,69,.17);white-space:nowrap;text-shadow:0 0 2px rgba(255,255,255,.7)}@media print{#document-dialog,.view-document{display:none!important}body:after{content:'Protected Naya Aasha documents are view-only and are not authorized for printing.';display:block;padding:40px;font-size:20px}}@media(max-width:600px){dialog{height:94vh}.dialog-head{min-height:76px}.viewer-wrap{height:calc(100% - 134px)}.viewer-watermark{font-size:28px}}
</style>
