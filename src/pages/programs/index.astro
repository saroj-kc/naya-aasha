---
import Base from '../../layouts/BaseLayout.astro'; import Icon from '../../components/Icon.astro'; import {getCollection,render} from 'astro:content';
const programs=(await getCollection('programs',({data})=>!data.draft)).sort((a,b)=>a.data.order-b.data.order); const rendered=await Promise.all(programs.map(async p=>({p,Content:(await render(p)).Content})));
---
<Base title="Our Programs | Naya Aasha" description="Explore Naya Aasha's programs for education, HIV care and inclusion, family support, and health."><section class="page-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / Programs</p><p class="eyebrow">What we do</p><h1 class="display">Practical support. <em style="color:var(--green);font-weight:400">Lasting possibility.</em></h1><p class="lead">Our programs are designed around assessed needs, local knowledge, responsible partnerships, and the resources available to us.</p></div></section><section class="section"><div class="wrap">{rendered.map(({p,Content})=><article class="program-detail" id={p.id}><div class="icon-box"><Icon name={p.data.icon} size={30}/></div><div><span class="meta">Program {String(p.data.order).padStart(2,'0')}</span><h2>{p.data.title}</h2><p class="lead">{p.data.summary}</p><div class="prose"><Content/></div><ul>{p.data.supportItems.map(item=><li>{item}</li>)}</ul><a class="text-link" href="/get-involved/">Support this work <Icon name="arrow" size={18}/></a></div></article>)}</div></section><section class="cta-band"><div class="wrap cta-inner"><div><p class="eyebrow light">A responsible approach</p><h2 class="heading">Support is based on need—not promises we cannot keep.</h2></div><a class="btn btn-light" href="/transparency/">How we stay accountable</a></div></section></Base>
