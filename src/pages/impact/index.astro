---
import Base from '../../layouts/BaseLayout.astro'; import {getCollection,render} from 'astro:content';
const stories=(await getCollection('stories',({data})=>!data.draft)).sort((a,b)=>+b.data.date-+a.data.date); const items=await Promise.all(stories.map(async s=>({s,Content:(await render(s)).Content})));
---
<Base title="Stories & Impact | Naya Aasha" description="Verified stories and impact updates from Naya Aasha."><section class="page-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / Stories & impact</p><p class="eyebrow">Stories & impact</p><h1 class="display">Progress, shared <em style="color:var(--green);font-weight:400">with dignity.</em></h1><p class="lead">We share verified results without exploiting personal hardship. Privacy and informed consent always come before publicity.</p></div></section><section class="section"><div class="wrap"><div class="cards-3">{items.map(({s,Content})=><article class="content-card"><div class="visual">आ</div><div class="body"><span class="meta">{s.data.date.toLocaleDateString('en-NP',{year:'numeric',month:'short'})} · {s.data.location}</span><h2>{s.data.title}</h2><p>{s.data.excerpt}</p><div class="prose"><Content/></div></div></article>)}</div>{items.length===0&&<div class="empty-state">Verified stories will be published here.</div>}</div></section></Base>
