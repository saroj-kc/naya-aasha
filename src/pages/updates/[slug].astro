---
import Base from '../../layouts/BaseLayout.astro';
import {getCollection,render} from 'astro:content';

export async function getStaticPaths(){
  const updates=await getCollection('updates',({data})=>!data.draft);
  return updates.map(update=>({
    params:{slug:update.id.replace(/\.(md|mdx)$/,'')},
    props:{update}
  }));
}

const {update}=Astro.props;
const {Content}=await render(update);
const formatDate=(date:Date)=>new Intl.DateTimeFormat('en-NP',{day:'numeric',month:'long',year:'numeric'}).format(date);
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<Base title={`${update.data.title} | Naya Aasha`} description={update.data.excerpt} image={update.data.image||'/images/social-card.svg'}>
  <article>
    <header class="article-header">
      <div class="article-heading">
        <p class="breadcrumb"><a href="/">Home</a> / <a href="/updates/">Updates</a> / Article</p>
        <p class="meta">{update.data.category} <span>·</span> <time datetime={update.data.date.toISOString()}>{formatDate(update.data.date)}</time></p>
        <h1>{update.data.title}</h1>
        <p class="article-excerpt">{update.data.excerpt}</p>
      </div>
    </header>

    {update.data.image&&<div class="hero-image"><img src={update.data.image} alt=""/></div>}

    <div class="article-layout">
      <div class:list={["article-prose",update.data.justifyText&&"justify-paragraphs"]}><Content/></div>
      <footer class="article-footer">
        <a class="btn btn-secondary" href="/updates/">← All news & updates</a>
        <p>Published by Naya Aasha · New Hope</p>
      </footer>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context':'https://schema.org','@type':'NewsArticle',headline:update.data.title,
    description:update.data.excerpt,datePublished:update.data.date.toISOString(),
    mainEntityOfPage:canonical.toString(),publisher:{'@type':'NGO',name:'Naya Aasha',url:'https://nayaaasha.org.np'},
    ...(update.data.image?{image:new URL(update.data.image,Astro.site).toString()}:{})
  })}></script>
</Base>

<style>
.article-header{background:var(--cream);padding:75px 20px 68px;border-bottom:1px solid var(--line)}.article-heading{width:min(920px,100%);margin-inline:auto}.article-heading .breadcrumb{margin-top:0}.meta{margin:0 0 18px;font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--green);font-weight:800}.meta span{color:#9eb2ae;margin:0 5px}.article-heading h1{font-family:var(--serif);font-size:clamp(40px,6vw,68px);line-height:1.05;letter-spacing:-.04em;margin:0;overflow-wrap:anywhere}.article-excerpt{font-size:clamp(18px,2vw,22px);line-height:1.65;color:var(--muted);max-width:820px;margin:25px 0 0}.hero-image{width:min(1050px,calc(100% - 40px));height:min(58vw,600px);margin:55px auto 0;border-radius:24px;overflow:hidden;background:var(--mint);box-shadow:var(--shadow)}.hero-image img{width:100%;height:100%;object-fit:cover}.article-layout{width:min(820px,calc(100% - 40px));margin:65px auto 100px}.article-prose{font-size:18px;line-height:1.85;color:#294744}.article-prose :global(p){margin:0 0 1.55em}.article-prose :global(h2){font-family:var(--serif);font-size:clamp(30px,4vw,43px);line-height:1.15;letter-spacing:-.025em;color:var(--ink);margin:1.7em 0 .65em}.article-prose :global(h3){font-family:var(--serif);font-size:28px;line-height:1.25;color:var(--ink);margin:1.6em 0 .6em}.article-prose :global(img){width:100%;height:auto;margin:38px 0 12px;border-radius:16px;box-shadow:0 12px 35px rgba(18,54,51,.12)}.article-prose :global(a){color:var(--green);font-weight:700;text-decoration:underline;text-underline-offset:3px}.article-prose :global(blockquote){margin:35px 0;padding:5px 0 5px 25px;border-left:4px solid var(--orange);font-family:var(--serif);font-size:24px;color:var(--ink)}.article-prose :global(ul),.article-prose :global(ol){padding-left:25px;margin-bottom:1.6em}.article-footer{margin-top:60px;padding-top:30px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px}.article-footer p{font-size:13px;color:var(--muted);margin:0}@media(max-width:600px){.article-header{padding:50px 14px 45px}.article-heading h1{font-size:39px}.article-excerpt{font-size:18px}.hero-image{width:calc(100% - 28px);height:62vw;margin-top:30px;border-radius:16px}.article-layout{width:calc(100% - 28px);margin:42px auto 70px}.article-prose{font-size:17px;line-height:1.78}.article-prose :global(img){margin:28px 0 10px;border-radius:12px}.article-footer{align-items:flex-start;flex-direction:column}}
</style>
