---
import Base from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const updates=(await getCollection('updates',({data})=>!data.draft)).sort((a,b)=>+b.data.date-+a.data.date);
const articleUrl=(id:string)=>`/updates/${id.replace(/\.(md|mdx)$/,'')}/`;
const formatDate=(date:Date)=>new Intl.DateTimeFormat('en-NP',{day:'numeric',month:'long',year:'numeric'}).format(date);
---
<Base title="News & Updates | Naya Aasha" description="Latest news, notices, and program updates from Naya Aasha.">
  <section class="page-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / Updates</p><p class="eyebrow">News & updates</p><h1 class="display">Follow the work <em>as it grows.</em></h1><p class="lead">Program notices, organizational news, opportunities, and field updates.</p></div></section>

  <section class="updates-section"><div class="wrap">
    {updates.length ? <div class="updates-grid">{updates.map((update,index)=>
      <article class:list={["update-card",index===0&&"featured"]}>
        <a class="card-visual" href={articleUrl(update.id)} aria-label={`Read ${update.data.title}`}>
          {update.data.image?<img src={update.data.image} alt="" loading={index===0?'eager':'lazy'}/>:<span aria-hidden="true">न</span>}
        </a>
        <div class="card-body">
          <p class="meta">{update.data.category} <span>·</span> <time datetime={update.data.date.toISOString()}>{formatDate(update.data.date)}</time></p>
          <h2><a href={articleUrl(update.id)}>{update.data.title}</a></h2>
          <p class="excerpt">{update.data.excerpt}</p>
          <a class="read-link" href={articleUrl(update.id)}>Read full article <span aria-hidden="true">→</span></a>
        </div>
      </article>
    )}</div>:<div class="empty-state">Published news and updates will appear here.</div>}
  </div></section>
</Base>

<style>
.page-hero .display em{color:var(--green);font-weight:400}.updates-section{padding:65px 0 95px;background:linear-gradient(#fff,#fbf8f1)}.updates-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,300px));justify-content:center;gap:24px}.update-card{height:355px;display:grid;grid-template-rows:105px 1fr;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 10px 30px rgba(18,54,51,.07);transition:transform .22s ease,box-shadow .22s ease}.update-card:hover{transform:translateY(-4px);box-shadow:0 18px 42px rgba(18,54,51,.13)}.card-visual{height:105px;overflow:hidden;background:linear-gradient(145deg,var(--mint),var(--orange-soft));display:grid;place-items:center}.card-visual img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.update-card:hover .card-visual img{transform:scale(1.025)}.card-visual span{font-family:var(--serif);font-size:52px;color:var(--green);opacity:.85}.card-body{min-height:0;padding:18px 20px 19px;display:flex;flex-direction:column}.meta{margin:0 0 8px;font-size:10px;line-height:1.4;text-transform:uppercase;letter-spacing:.08em;color:var(--green);font-weight:800}.meta span{color:#9eb2ae;margin:0 3px}.card-body h2{font-family:var(--serif);font-size:23px;line-height:1.16;letter-spacing:-.02em;margin:0 0 9px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.card-body h2 a:hover{color:var(--green)}.excerpt{color:var(--muted);margin:0;font-size:13px;line-height:1.55;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.read-link{color:var(--green);font-size:13px;font-weight:800;margin-top:auto;display:inline-flex;align-items:center;gap:7px}.read-link span{transition:transform .2s}.read-link:hover span{transform:translateX(4px)}@media(max-width:600px){.updates-section{padding:48px 0 70px}.updates-grid{grid-template-columns:minmax(0,420px);gap:18px}.update-card{height:340px;grid-template-rows:100px 1fr}.card-visual{height:100px}.card-body{padding:18px 20px}.card-body h2{font-size:22px}}
</style>
