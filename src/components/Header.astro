---
import site from '../content/pages/site.json';
const path=Astro.url.pathname;
const nav=[['About','/about/'],['Programs','/programs/'],['Impact','/impact/'],['Updates','/updates/'],['Get involved','/get-involved/'],['Contact','/contact/']];
---
<a class="skip" href="#main-content">Skip to main content</a>
<header class="site-header">
  <div class="nav-shell wrap">
    <a class="brand" href="/" aria-label="Naya Aasha home">
      <img class="brand-mark" src="/images/naya-aasha-logo.png" alt="" width="1600" height="1600" />
      <span><strong>{site.organizationName}</strong><small>{site.tagline}</small></span>
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span><span></span><b class="sr-only">Menu</b></button>
    <nav id="primary-nav" aria-label="Primary navigation">
      {nav.map(([label,url])=><a class:list={{active:path.startsWith(url)}} href={url}>{label}</a>)}
      <div class="language-switcher notranslate" translate="no" aria-label="Choose website language">
        <button type="button" data-language="en" aria-label="View website in English">ENG</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-language="ne" aria-label="Translate website into Nepali">नेपाली</button>
      </div>
      <div id="google_translate_element" class="translation-engine" aria-hidden="true"></div>
      <a class="btn btn-small" href="/donate/">Donate</a>
    </nav>
  </div>
</header>
<script is:inline>
const btn=document.querySelector('.menu-btn'), nav=document.querySelector('#primary-nav');
btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});

// Free automatic translation. English remains the original/source language.
window.googleTranslateElementInit=()=>{
  new google.translate.TranslateElement({
    pageLanguage:'en',
    includedLanguages:'en,ne',
    autoDisplay:false
  },'google_translate_element');
};
const translationCookie=()=>decodeURIComponent(document.cookie).match(/googtrans=\/en\/(en|ne)/)?.[1]||'en';
const markLanguage=()=>document.querySelectorAll('[data-language]').forEach(el=>{
  const active=el.dataset.language===translationCookie();
  el.classList.toggle('active',active);
  el.setAttribute('aria-pressed',String(active));
});
markLanguage();
document.querySelectorAll('[data-language]').forEach(el=>el.addEventListener('click',()=>{
  const language=el.dataset.language;
  document.cookie=`googtrans=/en/${language}; path=/; max-age=31536000; SameSite=Lax`;
  const selector=document.querySelector('.goog-te-combo');
  if(selector){selector.value=language;selector.dispatchEvent(new Event('change'));}
  else location.reload();
}));
</script>
<script is:inline async src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
<style>
.language-switcher{display:flex;align-items:center;gap:5px;padding:5px 8px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:11px;font-weight:800;letter-spacing:.04em;white-space:nowrap}
.language-switcher button{border:0;background:transparent;color:inherit;font:inherit;padding:3px 4px;cursor:pointer;border-radius:999px}
.language-switcher button:hover,.language-switcher button.active{color:var(--green-dark);background:var(--mint)}
.language-switcher button:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
.translation-engine{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important}
:global(.goog-te-banner-frame.skiptranslate),:global(.goog-te-gadget-icon){display:none!important}
:global(body){top:0!important}
@media(max-width:900px){.language-switcher{align-self:flex-start;margin:14px 0}}
</style>
