---
import site from '../content/pages/site.json';
const path=Astro.url.pathname;
const nav=[['About','/about/'],['Programs','/programs/'],['Impact','/impact/'],['Updates','/updates/'],['Get involved','/get-involved/'],['Contact','/contact/']];
---
<a class="skip" href="#main-content">Skip to main content</a>
<header class="site-header">
  <div class="nav-shell wrap">
    <a class="brand" href="/" aria-label="Naya Aasha home">
      <img class="brand-mark" src="/images/naya-aasha-profile-logo.png" alt="" width="1600" height="1600" />
      <span><strong>{site.organizationName}</strong><small>{site.tagline}</small></span>
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span><span></span><b class="sr-only">Menu</b></button>
    <nav id="primary-nav" aria-label="Primary navigation">
      {nav.map(([label,url])=><a class:list={{active:path.startsWith(url)}} href={url}>{label}</a>)}
      <a class="converter-link notranslate" translate="no" href="/unicode-preeti/" title="Unicode, Preeti and Roman converter" aria-label="Open Unicode, Preeti and Roman converter"><span aria-hidden="true">अ↔A</span><b>Converter</b></a>
      <label class="language-switcher notranslate" translate="no">
        <span class="sr-only">Choose website language</span>
        <select data-language-select aria-label="Choose website language">
          <option value="en">English</option>
          <option value="ne">नेपाली</option>
          <option value="fr">Français</option>
          <option value="es">Español</option>
          <option value="zh-CN">中文</option>
          <option value="de">Deutsch</option>
          <option value="ja">日本語</option>
          <option value="ko">한국어</option>
        </select>
      </label>
      <div id="google_translate_element" class="translation-engine" aria-hidden="true"></div>
      <a class="btn btn-small" href="/donate/">Donate</a>
    </nav>
  </div>
</header>
<script is:inline>
const btn=document.querySelector('.menu-btn'), nav=document.querySelector('#primary-nav');
btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});

// Free automatic translation. English remains the original/source language.
window.googleTranslateElementInit=()=>{
  new google.translate.TranslateElement({
    pageLanguage:'en',
    includedLanguages:'en,ne,fr,es,zh-CN,de,ja,ko',
    autoDisplay:false
  },'google_translate_element');
  setTimeout(()=>syncGoogleSelector(true),300);
};
const supportedLanguages=['en','ne','fr','es','zh-CN','de','ja','ko'];
const translationCookie=()=>{
  const match=decodeURIComponent(document.cookie).match(/googtrans=\/en\/([^;]+)/);
  return match&&supportedLanguages.includes(match[1])?match[1]:'en';
};
const languageSelect=document.querySelector('[data-language-select]');
if(languageSelect) languageSelect.value=translationCookie();
const syncGoogleSelector=(force=false,attempt=0)=>{
  const selector=document.querySelector('.goog-te-combo');
  const language=translationCookie();
  if(selector){
    if(force||selector.value!==language){
      selector.value=language;
      selector.dispatchEvent(new Event('change'));
    }
    return;
  }
  if(attempt<40)setTimeout(()=>syncGoogleSelector(force,attempt+1),250);
};
languageSelect?.addEventListener('change',()=>{
  const language=languageSelect.value;
  document.cookie=`googtrans=/en/${language}; path=/; max-age=31536000; SameSite=Lax`;
  syncGoogleSelector(true);
});
// Keep Google's old translation toolbar hidden; language choice remains in our header.
const hideGoogleToolbar=()=>{
  document.documentElement.style.setProperty('margin-top','0px','important');
  document.body.style.setProperty('top','0px','important');
  document.querySelectorAll('iframe.goog-te-banner-frame, iframe.skiptranslate, iframe.VIpgJd-ZVi9od-ORHb-OEVmcd').forEach(frame=>{
    frame.style.setProperty('display','none','important');
    frame.style.setProperty('height','0','important');
  });
};
hideGoogleToolbar();
new MutationObserver(hideGoogleToolbar).observe(document.documentElement,{childList:true,subtree:true});
let toolbarChecks=0;const toolbarTimer=setInterval(()=>{hideGoogleToolbar();if(++toolbarChecks>20)clearInterval(toolbarTimer)},500);
</script>
<script is:inline async src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
<style>
.converter-link{display:flex;align-items:center;gap:5px;color:var(--green-dark);font-size:11px;font-weight:800;white-space:nowrap}.converter-link span{display:grid;place-items:center;width:31px;height:31px;border-radius:50%;background:var(--orange-soft);color:#8a5700;font-size:13px}.converter-link:hover{color:var(--green)}
.language-switcher{display:flex;align-items:center;border:1px solid var(--line);border-radius:999px;background:#fff;white-space:nowrap}
.language-switcher select{max-width:108px;border:0;background:transparent;color:var(--green-dark);font:inherit;font-size:11px;font-weight:800;padding:8px 25px 8px 10px;cursor:pointer;border-radius:999px}
.language-switcher select:focus-visible{outline:2px solid var(--orange);outline-offset:2px}
.translation-engine{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important}
:global(.goog-te-banner-frame.skiptranslate),:global(iframe.goog-te-banner-frame),:global(iframe.skiptranslate),:global(iframe.VIpgJd-ZVi9od-ORHb-OEVmcd),:global(.goog-te-gadget-icon){display:none!important;height:0!important;visibility:hidden!important}
:global(html){margin-top:0!important}
:global(body){top:0!important;margin-top:0!important}
@media(max-width:900px){.converter-link{align-self:flex-start}.language-switcher{align-self:flex-start;margin:14px 0}}

</style>
