---
import Icon from './Icon.astro';
const {program}=Astro.props;
---
<article class="program-card">
 <div class="icon-box"><Icon name={program.data.icon}/></div>
 <span class="card-number">{String(program.data.order).padStart(2,'0')}</span>
 <h3>{program.data.title}</h3><p>{program.data.summary}</p>
 <a class="text-link" href={`/programs/#${program.id}`}><span>Learn more</span><Icon name="arrow" size={18}/></a>
</article>
